{
  "name": "dispersa",
  "version": "1.4.0",
  "description": "Core library for processing DTCG design tokens",
  "author": "Tim Gesemann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dispersa-core/dispersa.git",
    "directory": "packages/core"
  },
  "homepage": "https://dispersa.dev",
  "bugs": {
    "url": "https://github.com/dispersa-core/dispersa/issues"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "css",
    "tokens",
    "css-variables",
    "design-system",
    "token-pipeline"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dispersa": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./transforms": {
      "import": {
        "types": "./dist/processing/transforms/index.d.ts",
        "default": "./dist/processing/transforms/index.js"
      },
      "require": {
        "types": "./dist/processing/transforms/index.d.cts",
        "default": "./dist/processing/transforms/index.cjs"
      }
    },
    "./filters": {
      "import": {
        "types": "./dist/processing/filters/index.d.ts",
        "default": "./dist/processing/filters/index.js"
      },
      "require": {
        "types": "./dist/processing/filters/index.d.cts",
        "default": "./dist/processing/filters/index.cjs"
      }
    },
    "./outputs": {
      "import": {
        "types": "./dist/outputs/index.d.ts",
        "default": "./dist/outputs/index.js"
      },
      "require": {
        "types": "./dist/outputs/index.d.cts",
        "default": "./dist/outputs/index.cjs"
      }
    },
    "./preprocessors": {
      "import": {
        "types": "./dist/processing/preprocessors/index.d.ts",
        "default": "./dist/processing/preprocessors/index.js"
      },
      "require": {
        "types": "./dist/processing/preprocessors/index.d.cts",
        "default": "./dist/processing/preprocessors/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/shared/errors/index.d.ts",
        "default": "./dist/shared/errors/index.js"
      },
      "require": {
        "types": "./dist/shared/errors/index.d.cts",
        "default": "./dist/shared/errors/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/cli/config.d.ts",
        "default": "./dist/cli/config.js"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli/cli.d.ts",
        "default": "./dist/cli/cli.js"
      }
    },
    "./lint": {
      "import": {
        "types": "./dist/lint/index.d.ts",
        "default": "./dist/lint/index.js"
      },
      "require": {
        "types": "./dist/lint/index.d.cts",
        "default": "./dist/lint/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:contract": "vitest run tests/contract",
    "test:performance": "vitest run tests/performance --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "change-case": "^5.4.4",
    "culori": "^4.0.2",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "json-ptr": "^3.1.1",
    "json-schema-to-ts": "^3.1.1",
    "prettier": "^3.8.1"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
