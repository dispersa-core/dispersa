  "tokens.css": "/* Set: colors */
/* Color palette and alias colors */
:root {
  /* Primary action color */
  --color-action-brand: var(--color-palette-blue-500);
  /* Primary action hover */
  --color-action-brand-hover: var(--color-palette-blue-600);
  /* Strong/high-contrast action color */
  --color-action-brand-strong: var(--color-palette-blue-600);
  /* Strong action pressed */
  --color-action-brand-strong-active: var(--color-palette-blue-600);
  /* Destructive action color */
  --color-action-danger: var(--color-palette-red-500);
  /* Destructive action hover */
  --color-action-danger-hover: var(--color-palette-red-600);
  /* Subtle brand background */
  --color-background-brand-subtle: var(--color-palette-blue-100);
  /* Subtle danger background */
  --color-background-danger-subtle: var(--color-palette-red-100);
  /* Subtle success background */
  --color-background-success-subtle: var(--color-palette-green-100);
  /* Subtle warning background */
  --color-background-warning-subtle: var(--color-palette-orange-100);
  /* Focused border color */
  --color-border-default-focus: var(--color-palette-blue-500);
  /* Subtle/muted border color */
  --color-border-muted: var(--color-palette-gray-100);
  /* Success icon color */
  --color-icon-success: var(--color-palette-green-500);
  /* Warning icon color */
  --color-icon-warning: var(--color-palette-orange-500);
  /* Modal/dialog overlay */
  --color-overlay-default: #00000080;
  /* Pure black */
  --color-palette-black: #000000;
  /* Light blue for subtle backgrounds */
  --color-palette-blue-100: #deedff;
  /* Primary blue */
  --color-palette-blue-500: #0066cc;
  /* Darker blue for hover states */
  --color-palette-blue-600: #0054ab;
  /* Deep blue for strong/active states */
  --color-palette-blue-700: #00458c;
  /* Lightest gray */
  --color-palette-gray-100: #f5f5f7;
  /* Light gray */
  --color-palette-gray-300: #d6d9db;
  /* Medium-light gray */
  --color-palette-gray-400: #a1a6ab;
  /* Mid gray */
  --color-palette-gray-500: #6b757d;
  /* Dark gray */
  --color-palette-gray-700: #383d45;
  /* Darkest gray */
  --color-palette-gray-900: #1a1c1f;
  /* Light green for subtle backgrounds */
  --color-palette-green-100: #d9f5e0;
  /* Success green */
  --color-palette-green-500: #21ad4d;
  /* Light orange for subtle backgrounds */
  --color-palette-orange-100: #fff2d9;
  /* Warning orange */
  --color-palette-orange-500: #ed941a;
  /* Light red for subtle backgrounds */
  --color-palette-red-100: #ffe6e6;
  /* Lighter red for muted danger text */
  --color-palette-red-400: #f07070;
  /* Error red */
  --color-palette-red-500: #db2626;
  /* Darker red for hover states */
  --color-palette-red-600: #b81c1c;
  /* Pure white */
  --color-palette-white: #ffffff;
  /* Brand-colored text */
  --color-text-brand: var(--color-palette-blue-500);
  /* Danger/error text color */
  --color-text-danger: var(--color-palette-red-500);
  /* Subdued danger text color */
  --color-text-danger-muted: var(--color-palette-red-600);
  /* Text on dark backgrounds */
  --color-text-inverse: var(--color-palette-white);
  /* Disabled text color */
  --color-text-muted-disabled: var(--color-palette-gray-300);
  /* Success text color */
  --color-text-success: var(--color-palette-green-500);
}


/* Set: typography */
/* Font families, sizes, weights, and line heights */
:root {
  /* Monospace font stack for code */
  --font-family-mono: "JetBrains Mono", "Fira Code", monospace;
  /* Default sans-serif font stack */
  --font-family-sans: Inter, system-ui, sans-serif;
  --font-line-height-normal: 1.5;
  --font-line-height-relaxed: 1.75;
  --font-line-height-tight: 1.25;
  --font-size-2xl: 1.5rem;
  --font-size-3xl: 2rem;
  --font-size-base: 1rem;
  --font-size-lg: 1.125rem;
  --font-size-sm: 0.875rem;
  --font-size-xl: 1.25rem;
  --font-size-xs: 0.75rem;
  --font-weight-bold: 700;
  --font-weight-medium: 500;
  --font-weight-regular: 400;
  --font-weight-semibold: 600;
  /* Default body text */
  --typography-body-md-fontFamily-0: Inter;
  --typography-body-md-fontFamily-1: system-ui;
  --typography-body-md-fontFamily-2: sans-serif;
  --typography-body-md-fontSize: var(--font-size-base);
  --typography-body-md-fontWeight: var(--font-weight-regular);
  --typography-body-md-letterSpacing: 0rem;
  --typography-body-md-lineHeight: var(--font-line-height-normal);
  /* Small body text / captions */
  --typography-body-sm-fontFamily-0: Inter;
  --typography-body-sm-fontFamily-1: system-ui;
  --typography-body-sm-fontFamily-2: sans-serif;
  --typography-body-sm-fontSize: var(--font-size-sm);
  --typography-body-sm-fontWeight: var(--font-weight-regular);
  --typography-body-sm-letterSpacing: 0rem;
  --typography-body-sm-lineHeight: var(--font-line-height-normal);
  /* Large heading (h1) */
  --typography-heading-lg-fontFamily-0: Inter;
  --typography-heading-lg-fontFamily-1: system-ui;
  --typography-heading-lg-fontFamily-2: sans-serif;
  --typography-heading-lg-fontSize: var(--font-size-3xl);
  --typography-heading-lg-fontWeight: var(--font-weight-bold);
  --typography-heading-lg-letterSpacing: -0.02rem;
  --typography-heading-lg-lineHeight: var(--font-line-height-tight);
  /* Medium heading (h2) */
  --typography-heading-md-fontFamily-0: Inter;
  --typography-heading-md-fontFamily-1: system-ui;
  --typography-heading-md-fontFamily-2: sans-serif;
  --typography-heading-md-fontSize: var(--font-size-2xl);
  --typography-heading-md-fontWeight: var(--font-weight-semibold);
  --typography-heading-md-letterSpacing: -0.01rem;
  --typography-heading-md-lineHeight: var(--font-line-height-tight);
  /* Small heading (h3) */
  --typography-heading-sm-fontFamily-0: Inter;
  --typography-heading-sm-fontFamily-1: system-ui;
  --typography-heading-sm-fontFamily-2: sans-serif;
  --typography-heading-sm-fontSize: var(--font-size-xl);
  --typography-heading-sm-fontWeight: var(--font-weight-semibold);
  --typography-heading-sm-letterSpacing: 0rem;
  --typography-heading-sm-lineHeight: var(--font-line-height-tight);
}


/* Set: spacing */
/* Spacing scale and alias spacing */
:root {
  --spacing-gap-lg: var(--spacing-scale-lg);
  --spacing-gap-md: var(--spacing-scale-md);
  --spacing-gap-sm: var(--spacing-scale-sm);
  --spacing-gap-xl: var(--spacing-scale-xl);
  --spacing-gap-xs: var(--spacing-scale-xs);
  --spacing-inset-lg: var(--spacing-scale-lg);
  --spacing-inset-md: var(--spacing-scale-md);
  --spacing-inset-sm: var(--spacing-scale-sm);
  --spacing-inset-xl: var(--spacing-scale-xl);
  --spacing-inset-xs: var(--spacing-scale-xs);
  --spacing-scale-2xl: 3rem;
  --spacing-scale-lg: 1.5rem;
  --spacing-scale-md: 1rem;
  --spacing-scale-sm: 0.5rem;
  --spacing-scale-xl: 2rem;
  --spacing-scale-xs: 0.25rem;
}


/* Set: effects */
/* Shadows and elevation */
:root {
  /* High elevation (modals, dialogs) */
  --shadow-elevation-lg: var(--shadow-raw-lg);
  /* Medium elevation (dropdowns, popovers) */
  --shadow-elevation-md: var(--shadow-raw-md);
  /* Low elevation (cards, inputs) */
  --shadow-elevation-sm: var(--shadow-raw-sm);
  /* Large shadow for modals and dialogs */
  --shadow-raw-lg: var(--shadow-raw-lg-offsetX) var(--shadow-raw-lg-offsetY)
    var(--shadow-raw-lg-blur) var(--shadow-raw-lg-spread)
    var(--shadow-raw-lg-color);
  --shadow-raw-lg-color: #0000001a;
  --shadow-raw-lg-offsetX: 0px;
  --shadow-raw-lg-offsetY: 10px;
  --shadow-raw-lg-blur: 15px;
  --shadow-raw-lg-spread: -3px;
  /* Medium shadow for dropdowns and popovers */
  --shadow-raw-md: var(--shadow-raw-md-offsetX) var(--shadow-raw-md-offsetY)
    var(--shadow-raw-md-blur) var(--shadow-raw-md-spread)
    var(--shadow-raw-md-color);
  --shadow-raw-md-color: #0000001a;
  --shadow-raw-md-offsetX: 0px;
  --shadow-raw-md-offsetY: 4px;
  --shadow-raw-md-blur: 6px;
  --shadow-raw-md-spread: -1px;
  /* Subtle shadow for cards and inputs */
  --shadow-raw-sm: var(--shadow-raw-sm-offsetX) var(--shadow-raw-sm-offsetY)
    var(--shadow-raw-sm-blur) var(--shadow-raw-sm-spread)
    var(--shadow-raw-sm-color);
  --shadow-raw-sm-color: #0000000d;
  --shadow-raw-sm-offsetX: 0px;
  --shadow-raw-sm-offsetY: 1px;
  --shadow-raw-sm-blur: 2px;
  --shadow-raw-sm-spread: 0px;
}


/* Modifier: theme=light (default) */
/* Theme variations */
:root {
  /* Light page background */
  --color-background-default: var(--color-palette-white);
  /* Light border color */
  --color-border-default: var(--color-palette-gray-300);
  /* Light surface for cards */
  --color-surface-default: var(--color-palette-gray-100);
  /* Dark text on light background */
  --color-text-default: var(--color-palette-gray-900);
  /* Muted text on light background */
  --color-text-muted: var(--color-palette-gray-500);
}


/* Modifier: theme=dark */
[data-theme="dark"] {
  /* Dark page background */
  --color-background-default: var(--color-palette-gray-900);
  /* Dark border color */
  --color-border-default: var(--color-palette-gray-700);
  /* Dark surface for cards */
  --color-surface-default: var(--color-palette-gray-700);
  /* Light text on dark background */
  --color-text-default: var(--color-palette-gray-100);
  /* Muted text on dark background */
  --color-text-muted: var(--color-palette-gray-400);
}
