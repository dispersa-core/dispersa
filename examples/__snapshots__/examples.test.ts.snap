  "tailwind/theme.css": "@custom-variant theme-dark (&:where([data-theme="dark"], [data-theme="dark"] *));

@theme {
  /* Accent background */
  --color-background-accent-default: #3b63fb;
  /* Accent background hover */
  --color-background-accent-hover: #274dea;
  /* Danger background */
  --color-background-danger-default: #be1f10;
  /* Page background */
  --color-background-default: #ffffff;
  /* Disabled background */
  --color-background-disabled: #e9e9e9;
  /* First layer surface */
  --color-background-layer-1: #f8f8f8;
  /* Second layer surface */
  --color-background-layer-2: #f3f3f3;
  /* Neutral background */
  --color-background-neutral-default: #292929;
  /* Neutral background hover */
  --color-background-neutral-hover: #131313;
  /* Success background */
  --color-background-success-default: #006822;
  /* Warning background */
  --color-background-warning-default: #e07700;
  /* Default border color */
  --color-border-default: #dadada;
  /* Focus ring color */
  --color-border-focus: #4b75ff;
  /* Hover border color */
  --color-border-hover: #c6c6c6;
  /* Spectrum blue-1000 */
  --color-palette-blue-1000: #274dea;
  /* Spectrum blue-1100 */
  --color-palette-blue-1100: #1d3ecf;
  /* Spectrum blue-400 */
  --color-palette-blue-400: #accffd;
  /* Spectrum blue-600 */
  --color-palette-blue-600: #729efd;
  /* Spectrum blue-800 */
  --color-palette-blue-800: #4b75ff;
  /* Spectrum blue-900 */
  --color-palette-blue-900: #3b63fb;
  /* Spectrum gray-100 */
  --color-palette-gray-100: #e9e9e9;
  /* Spectrum gray-200 */
  --color-palette-gray-200: #e1e1e1;
  /* Spectrum gray-25 (lightest) */
  --color-palette-gray-25: #ffffff;
  /* Spectrum gray-300 */
  --color-palette-gray-300: #dadada;
  /* Spectrum gray-400 */
  --color-palette-gray-400: #c6c6c6;
  /* Spectrum gray-50 */
  --color-palette-gray-50: #f8f8f8;
  /* Spectrum gray-500 */
  --color-palette-gray-500: #8f8f8f;
  /* Spectrum gray-600 */
  --color-palette-gray-600: #717171;
  /* Spectrum gray-700 */
  --color-palette-gray-700: #505050;
  /* Spectrum gray-75 */
  --color-palette-gray-75: #f3f3f3;
  /* Spectrum gray-800 */
  --color-palette-gray-800: #292929;
  /* Spectrum gray-900 (darkest) */
  --color-palette-gray-900: #131313;
  /* Spectrum green-1000 */
  --color-palette-green-1000: #00591b;
  /* Spectrum green-600 */
  --color-palette-green-600: #10963c;
  /* Spectrum green-800 */
  --color-palette-green-800: #03772a;
  /* Spectrum green-900 */
  --color-palette-green-900: #006822;
  /* Spectrum orange-600 */
  --color-palette-orange-600: #e07700;
  /* Spectrum orange-800 */
  --color-palette-orange-800: #bd5600;
  /* Spectrum orange-900 */
  --color-palette-orange-900: #aa4800;
  /* Spectrum red-1000 */
  --color-palette-red-1000: #aa1509;
  /* Spectrum red-600 */
  --color-palette-red-600: #ea483a;
  /* Spectrum red-800 */
  --color-palette-red-800: #d02918;
  /* Spectrum red-900 */
  --color-palette-red-900: #be1f10;
  /* Static black */
  --color-palette-static-black: #000000;
  /* Static white */
  --color-palette-static-white: #ffffff;
  /* Primary text */
  --color-text-default: #131313;
  /* Disabled text */
  --color-text-disabled: #c6c6c6;
  /* Text on accent backgrounds */
  --color-text-inverse: #ffffff;
  /* Secondary text */
  --color-text-secondary: #505050;
  --spacing-layout-border-width-100: 1px;
  --spacing-layout-border-width-200: 2px;
  --spacing-layout-corner-radius-100: 4px;
  --spacing-layout-corner-radius-200: 5px;
  --spacing-layout-corner-radius-500: 8px;
  --spacing-layout-corner-radius-75: 3px;
  --spacing-layout-corner-radius-800: 16px;
  --duration-motion-duration-100: 130ms;
  --duration-motion-duration-200: 250ms;
  --duration-motion-duration-300: 400ms;
  /* Subtle card shadow */
  --shadow-raw-100: 0px 1px 4px 0px #0000001f;
  /* Popover / dropdown shadow */
  --shadow-raw-200: 0px 4px 16px 0px #00000029;
  /* Modal shadow */
  --shadow-raw-300: 0px 8px 28px 0px #0000003d;
  --spacing-scale-100: 8px;
  --spacing-scale-200: 12px;
  --spacing-scale-300: 16px;
  --spacing-scale-400: 24px;
  --spacing-scale-50: 2px;
  --spacing-scale-500: 32px;
  --spacing-scale-600: 40px;
  /* Spectrum sans-serif font stack */
  --font-typography-font-family-sans:
    "Adobe Clean", ui-sans-serif, system-ui, sans-serif;
  /* Spectrum serif font stack */
  --font-typography-font-family-serif:
    "Adobe Clean Serif", ui-serif, Georgia, serif;
  --spacing-typography-font-size-100: 14px;
  --spacing-typography-font-size-200: 16px;
  --spacing-typography-font-size-300: 18px;
  --spacing-typography-font-size-400: 20px;
  --spacing-typography-font-size-500: 22px;
  --spacing-typography-font-size-75: 12px;
  --font-weight-typography-font-weight-black: 900;
  --font-weight-typography-font-weight-bold: 700;
  --font-weight-typography-font-weight-extra-bold: 800;
  --font-weight-typography-font-weight-light: 300;
  --font-weight-typography-font-weight-medium: 500;
  --font-weight-typography-font-weight-regular: 400;
}

