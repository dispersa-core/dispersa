  --shadow-base-sm-0-offsetY: 1px;
  --shadow-base-sm-0-blur: 2px;
  --shadow-base-sm-0-spread: 0px;
  --shadow-base-xl: 0px 20px 25px -5px #00000026;
  --shadow-base-xl-0-color: #00000026;
  --shadow-base-xl-0-offsetX: 0px;
  --shadow-base-xl-0-offsetY: 20px;
  --shadow-base-xl-0-blur: 25px;
  --shadow-base-xl-0-spread: -5px;
  --size-base-2xl: 64px;
  --size-base-lg: 40px;
  --size-base-md: 32px;
  --size-base-sm: 24px;
  --size-base-xl: 48px;
  --size-base-xs: 20px;
  --spacing-base-0: 0px;
  /* 4px */
  --spacing-base-1: 0.25rem;
  /* 48px */
  --spacing-base-12: 3rem;
  /* 64px */
  --spacing-base-16: 4rem;
  /* 8px */
  --spacing-base-2: 0.5rem;
  /* 80px */
  --spacing-base-20: 5rem;
  /* 12px */
  --spacing-base-3: 0.75rem;
  /* 16px */
  --spacing-base-4: 1rem;
  /* 24px */
  --spacing-base-6: 1.5rem;
  /* 32px */
  --spacing-base-8: 2rem;
}


/* Set: alias */
/* Alias token layer with component compositions */
:root {
  /* Inverse background (dark) */
  --color-alias-background-inverse: #111827;
  /* Primary background */
  --color-alias-background-primary: #ffffff;
  /* Secondary background */
  --color-alias-background-secondary: #f9fafb;
  /* Tertiary background */
  --color-alias-background-tertiary: #f3f4f6;
  /* Default border color */
  --color-alias-border-default: #e5e7eb;
  /* Prominent border */
  --color-alias-border-strong: #6b7280;
  /* Subtle border */
  --color-alias-border-subtle: #f3f4f6;
  --color-alias-danger: #ef4444;
  --color-alias-info: #3399cc;
  /* Active state */
  --color-alias-interactive-active: #0047b3;
  /* Hover state */
  --color-alias-interactive-hover: #0052cc;
  /* Primary interactive color */
  --color-alias-interactive-primary: #0066ff;
  --color-alias-success: #10b981;
  /* Inverse text (on dark backgrounds) */
  --color-alias-text-inverse: #ffffff;
  /* Primary text color */
  --color-alias-text-primary: #111827;
  /* Secondary text color */
  --color-alias-text-secondary: #545d6b;
  /* Tertiary text color */
  --color-alias-text-tertiary: #a1a8b5;
  --color-alias-warning: #f59e25;
  --color-button-primary-background: #0066ff;
  --color-button-primary-background-active: #0047b3;
  --color-button-primary-background-hover: #0052cc;
  --color-button-primary-text: #ffffff;
  --color-button-secondary-background: #f9fafb;
  --color-button-secondary-border: #e5e7eb;
  --color-button-secondary-text: #111827;
  --color-card-background: #ffffff;
  --color-card-border: #f3f4f6;
  --color-input-background: #ffffff;
  --color-input-border: #e5e7eb;
  --color-input-border-focus: #0066ff;
  --color-input-placeholder: #a1a8b5;
  --color-input-text: #111827;
  --shadow-card-shadow: 0px 4px 6px -1px #0000001a;
  --shadow-card-shadow-0-color: #0000001a;
  --shadow-card-shadow-0-offsetX: 0px;
  --shadow-card-shadow-0-offsetY: 4px;
  --shadow-card-shadow-0-blur: 6px;
  --shadow-card-shadow-0-spread: -1px;
  --spacing-alias-lg: 2rem;
  --spacing-alias-md: 1rem;
  --spacing-alias-sm: 0.5rem;
  --spacing-alias-xl: 3rem;
  --spacing-alias-xs: 0.25rem;
  --spacing-button-primary-padding: 1rem;
  --spacing-button-secondary-padding: 1rem;
  --spacing-card-padding: 2rem;
  --spacing-card-radius: 0.25rem;
  --spacing-input-padding: 0.5rem;
  --typography-alias-body-lg-family:
    Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --typography-alias-body-lg-size: 1.125rem;
  --typography-alias-body-lg-weight: 400;
  --typography-alias-body-md-family:
    Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --typography-alias-body-md-size: 1rem;
  --typography-alias-body-md-weight: 400;
  --typography-alias-body-sm-family:
    Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --typography-alias-body-sm-size: 0.875rem;
  --typography-alias-body-sm-weight: 400;
  --typography-alias-heading-lg-family: Poppins, Inter, sans-serif;
  --typography-alias-heading-lg-size: 1.875rem;
  --typography-alias-heading-lg-weight: 700;
  --typography-alias-heading-md-family:
    Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --typography-alias-heading-md-size: 1.25rem;
  --typography-alias-heading-md-weight: 600;
  --typography-alias-heading-xl-family: Poppins, Inter, sans-serif;
  --typography-alias-heading-xl-size: 3rem;
  --typography-alias-heading-xl-weight: 700;
}


/* Modifier: brand=partner-a */
[data-brand="partner-a"] {
  /* Partner A primary color - red */
  --color-base-brand-primary: #cc3366;
  --color-base-brand-secondary: #e68033;
}


/* Modifier: brand=partner-b */
[data-brand="partner-b"] {
  /* Partner B primary color - green */
  --color-base-brand-primary: #33b366;
  --color-base-brand-secondary: #4d80cc;
}


/* Modifier: platform=mobile */
[data-platform="mobile"] {
  /* Larger touch target */
  --button-primary-padding: 16px;
  --spacing-alias-md: 16px;
  /* Slightly larger for touch */
  --spacing-alias-sm: 12px;
}


/* Modifier: platform=desktop */
[data-platform="desktop"] {
  /* Larger spacing for desktop */
  --spacing-alias-xl: 4rem;
}


/* Modifier: platform=tv */
[data-platform="tv"] {
  /* Larger base size for TV viewing distance */
  --font-base-size-base: 1.5rem;
  --spacing-alias-lg: 3rem;
  --spacing-alias-md: 2rem;
}


/* Modifier: density=compact */
[data-density="compact"] {
  --button-primary-padding: 8px;
  --spacing-alias-md: 8px;
  --spacing-alias-sm: 4px;
  --spacing-alias-xs: 2px;
}


/* Modifier: density=spacious */
[data-density="spacious"] {
  --spacing-alias-lg: 3rem;
  --spacing-alias-md: 1.5rem;
  --spacing-alias-xl: 5rem;
}


/* Modifier: theme=dark */
[data-theme="dark"] {
  --color-alias-background-inverse: #ffffff;
  --color-alias-background-primary: #111827;
  --color-alias-background-secondary: #21293b;
  --color-alias-background-tertiary: #424b5e;
  --color-alias-border-default: #424b5e;
  --color-alias-border-strong: #6b7280;
  --color-alias-interactive-hover: #66b3ff;
  /* Brighter blue for dark background */
  --color-alias-interactive-primary: #4d99ff;
  --color-alias-text-inverse: #111827;
  --color-alias-text-primary: #f9fafb;
  --color-alias-text-secondary: #a1a8b5;
}


/* Modifier: theme=high-contrast */
[data-theme="high-contrast"] {
  --color-alias-background-primary: #000000;
  --color-alias-background-secondary: #111827;
  --color-alias-border-default: #ffffff;
  --color-alias-border-strong: #ffffff;
  --color-alias-interactive-primary: #66ccff;
  --color-alias-text-primary: #ffffff;
  --color-alias-text-secondary: #e5e7eb;
}


/* Modifier: accessibility=reduced-motion */
[data-accessibility="reduced-motion"] {
  --duration-base-fast: 0ms;
  --duration-base-normal: 0ms;
  --duration-base-slow: 0ms;
}


/* Modifier: accessibility=enhanced-contrast */
[data-accessibility="enhanced-contrast"] {
  /* Stronger borders for high contrast */
  --color-alias-border-default: #111827;
  --color-alias-border-strong: #000000;
}
",
