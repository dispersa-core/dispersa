  "tokens-mod-base.css": "/* Set: base */
/* Base foundational values */
:root {
  /* Accent shadow using brand color */
  --shadow-advanced-accent: 0px 4px 8px 0px #0066ff;
  --shadow-advanced-accent-color: #0066ff;
  --shadow-advanced-accent-offsetX: 0px;
  --shadow-advanced-accent-offsetY: 4px;
  --shadow-advanced-accent-blur: 8px;
  --shadow-advanced-accent-spread: 0px;
  /* Focus ring for dark theme */
  --shadow-dark-focus: 0px 0px 0px 3px #0066ff;
  --shadow-dark-focus-0-color: #0066ff;
  --shadow-dark-focus-0-offsetX: 0px;
  --shadow-dark-focus-0-offsetY: 0px;
  --shadow-dark-focus-0-blur: 0px;
  --shadow-dark-focus-0-spread: 3px;
  /* Focus ring shadow using alias color reference */
  --shadow-focus: 0px 0px 0px 3px #0066ff;
  --shadow-focus-0-color: #0066ff;
  --shadow-focus-0-offsetX: 0px;
  --shadow-focus-0-offsetY: 0px;
  --shadow-focus-0-blur: 0px;
  --shadow-focus-0-spread: 3px;
  /* Prominent focus ring for high contrast */
  --shadow-high-contrast-focus: 0px 0px 0px 4px #ffff00;
  --shadow-high-contrast-focus-0-color: #ffff00;
  --shadow-high-contrast-focus-0-offsetX: 0px;
  --shadow-high-contrast-focus-0-offsetY: 0px;
  --shadow-high-contrast-focus-0-blur: 0px;
  --shadow-high-contrast-focus-0-spread: 4px;
}

/* Set: alias */
/* Alias token layer with component tokens */
:root {
  /* Default component outline */
  --border-width-alias-default: 2px;
  /* Emphasis or high-contrast outline */
  --border-width-alias-strong: 3px;
  /* Danger/error state color */
  --color-alias-danger: color(srgb 0.937 0.267 0.267);
  /* Focus ring color */
  --color-alias-focus: color(srgb 0 0.4 1);
  /* Semi-transparent white for glass effects */
  --color-alias-glassmorphism: color(srgb 1 1 1 / 0.9);
  /* Info color */
  --color-alias-info: color(srgb 0.42 0.275 0.757);
  /* Stronger overlay using alpha token reference */
  --color-alias-overlay-strong: color(srgb 0 0 0 / 0.7);
  /* Primary action color referencing base */
  --color-alias-primary: color(srgb 0 0.4 1);
  /* Subtle primary with low opacity */
  --color-alias-primary-subtle: color(srgb 0 0.4 1 / 0.1);
  /* Success state color */
  --color-alias-success: color(srgb 0.063 0.725 0.506);
  /* Warning color */
  --color-alias-warning: color(srgb 0.961 0.62 0.043);
  /* Primary button background */
  --color-button-primary-background: color(srgb 0 0.4 1);
  /* Primary button hover state */
  --color-button-primary-background-hover: color(srgb 0 0.322 0.8);
  /* Primary button text color */
  --color-button-primary-text: color(srgb 1 1 1);
  /* Card background color */
  --color-card-background: color(srgb 0.976 0.98 0.984);
  /* Card border color */
  --color-card-border: color(srgb 0.953 0.957 0.965);
  /* Card elevation shadow (medium) */
  --shadow-card-shadow: 0px 4px 6px -1px #0000001a, 0px 2px 4px -1px #0000000f;
  --shadow-card-shadow-0-color: #0000001a;
  --shadow-card-shadow-0-offsetX: 0px;
  --shadow-card-shadow-0-offsetY: 4px;
  --shadow-card-shadow-0-blur: 6px;
  --shadow-card-shadow-0-spread: -1px;
  --shadow-card-shadow-1-color: #0000000f;
  --shadow-card-shadow-1-offsetX: 0px;
  --shadow-card-shadow-1-offsetY: 2px;
  --shadow-card-shadow-1-blur: 4px;
  --shadow-card-shadow-1-spread: -1px;
  --spacing-alias-medium: 16px;
  --spacing-alias-small: 8px;
  /* Button padding */
  --spacing-button-primary-padding: 16px;
  /* Card internal padding */
  --spacing-card-padding: 64px;
}
",
  "tokens-mod-density-comfortable-platform-desktop-theme-dark.css": ":root[data-theme="dark"] {
  /* Dark theme background - deeper than base gray.900 */
  --color-alias-background: color(srgb 0.059 0.078 0.098);
  /* Subdued border for dark theme */
  --color-alias-border: color(srgb 0.176 0.216 0.282);
  /* Stronger border still subtle */
  --color-alias-border-strong: color(srgb 0.29 0.333 0.408);
  /* Softer red for dark backgrounds */
  --color-alias-danger: color(srgb 0.973 0.443 0.443);
  /* Dark glass effect */
  --color-alias-glassmorphism: color(srgb 0.1 0.1 0.15 / 0.8);
  /* Stronger overlay for dark theme */
  --color-alias-overlay: color(srgb 0 0 0 / 0.7);
  /* Brighter blue for dark backgrounds using sRGB */
  --color-alias-primary: color(srgb 0.302 0.604 1);
  /* Even brighter on hover */
  --color-alias-primary-hover: color(srgb 0.416 0.69 1);
  /* Subtle primary for dark theme */
  --color-alias-primary-subtle: color(srgb 0.302 0.604 1 / 0.2);
  /* Brighter green for dark backgrounds */
  --color-alias-success: color(srgb 0.204 0.827 0.6);
  /* Dark theme surface - elevated from background */
  --color-alias-surface: color(srgb 0.102 0.122 0.161);
  /* Dark theme text - slightly off-white for reduced eye strain */
  --color-alias-text: color(srgb 0.91 0.918 0.929);
  /* Dark theme muted text */
  --color-alias-text-muted: color(srgb 0.612 0.639 0.686);
  /* Bright yellow for dark backgrounds */
  --color-alias-warning: color(srgb 0.984 0.749 0.141);
  /* Focus ring with dark theme primary color */
  --shadow-focus: 0px 0px 0px 3px #4d9aff;
  --shadow-focus-0-color: #4d9aff;
  --shadow-focus-0-offsetX: 0px;
  --shadow-focus-0-offsetY: 0px;
  --shadow-focus-0-blur: 0px;
  --shadow-focus-0-spread: 3px;
  /* Medium shadow adjusted for dark theme */
  --shadow-md: 0px 4px 8px -1px #0000004d;
  --shadow-md-0-color: #0000004d;
  --shadow-md-0-offsetX: 0px;
  --shadow-md-0-offsetY: 4px;
  --shadow-md-0-blur: 8px;
  --shadow-md-0-spread: -1px;
}
",
  "tokens-mod-density-comfortable-platform-desktop-theme-forest.css": ":root[data-theme="forest"] {
  /* Soft forest fog background */
  --color-alias-background: color(srgb 0.976 0.98 0.984);
  /* Soft bark border */
  --color-alias-border: color(srgb 0.898 0.906 0.922);
  /* Strong bark border */
  --color-alias-border-strong: color(srgb 0.42 0.447 0.502);
  /* Forest overlay */
  --color-alias-overlay: color(srgb 0 0 0 / 0.5);
  /* Forest green accent */
  --color-alias-primary: color(srgb 0.063 0.725 0.506);
  /* Brighter green hover */
  --color-alias-primary-hover: color(rec2020 0.1 0.9 0.3);
  /* Soft green wash */
  --color-alias-primary-subtle: color(srgb 0 0.4 1 / 0.1);
  /* Forest success green */
  --color-alias-success: color(srgb 0.063 0.725 0.506);
  /* Raised surface on fog */
  --color-alias-surface: color(srgb 1 1 1);
  /* Deep forest text */
  --color-alias-text: color(srgb 0.067 0.094 0.153);
  /* Muted forest text */
  --color-alias-text-muted: color(srgb 0.259 0.294 0.369);
}
",
  "tokens-mod-density-comfortable-platform-desktop-theme-high-contrast.css": ":root[data-theme="high-contrast"] {
  /* Thicker outlines for high contrast */
  --border-width-alias-default: 3px;
  /* Strong outlines for emphasis */
  --border-width-alias-strong: 3px;
  /* High contrast background - pure black */
  --color-alias-background: color(srgb 0 0 0);
  /* White borders for maximum contrast */
  --color-alias-border: color(srgb 1 1 1);
  /* Same as border in high contrast */
  --color-alias-border-strong: color(srgb 1 1 1);
  /* Pure red for high contrast */
  --color-alias-danger: color(srgb 1 0 0);
  /* Yellow focus rings for visibility */
  --color-alias-focus: color(srgb 1 1 0);
  /* Cyan for info */
  --color-alias-info: color(srgb 0 1 1);
  /* Strong overlay */
  --color-alias-overlay: color(srgb 0 0 0 / 0.9);
  /* High contrast primary - bright cyan for maximum visibility */
  --color-alias-primary: color(srgb 0 0.765 1);
  /* Even brighter on hover */
  --color-alias-primary-hover: color(srgb 0 0.898 1);
  /* Subtle primary still visible in high contrast */
  --color-alias-primary-subtle: color(srgb 0 0.765 1 / 0.3);
  /* Pure green for high contrast */
  --color-alias-success: color(srgb 0 1 0);
  /* High contrast surface - slightly elevated */
  --color-alias-surface: color(srgb 0.102 0.102 0.102);
  /* High contrast text - pure white */
  --color-alias-text: color(srgb 1 1 1);
  /* High contrast muted text - still very legible */
  --color-alias-text-muted: color(srgb 0.816 0.816 0.816);
  /* Pure yellow for high contrast */
  --color-alias-warning: color(srgb 1 1 0);
  /* Extra-bold for high contrast */
  --font-weight-bold: 800;
  /* Semi-bold for emphasis */
  --font-weight-medium: 600;
  /* Medium weight for better readability */
  --font-weight-normal: 600;
  /* Sharp corners for high contrast */
  --radius-alias-control: 0px;
  /* Sharp surfaces for high contrast */
  --radius-alias-surface: 0px;
  /* Prominent focus ring for high contrast */
  --shadow-focus: 0px 0px 0px 4px #ffff00;
  --shadow-focus-0-color: #ffff00;
  --shadow-focus-0-offsetX: 0px;
  --shadow-focus-0-offsetY: 0px;
  --shadow-focus-0-blur: 0px;
  --shadow-focus-0-spread: 4px;
  /* Light shadow for high contrast dark theme */
  --shadow-md: 0px 4px 8px 0px #ffffff26;
  --shadow-md-0-color: #ffffff26;
  --shadow-md-0-offsetX: 0px;
  --shadow-md-0-offsetY: 4px;
  --shadow-md-0-blur: 8px;
  --shadow-md-0-spread: 0px;
  /* Much larger spacing */
  --spacing-semantic-large: 48px;
  /* Larger spacing for better separation */
  --spacing-semantic-medium: 24px;
  /* Slightly larger spacing for high contrast */
  --spacing-semantic-small: 12px;
}
",
  "tokens-mod-density-comfortable-platform-desktop-theme-light.css": ":root {
  /* Sharper control corners on desktop */
  --radius-alias-control: 2px;
  /* Sharper surface corners on desktop */
  --radius-alias-surface: 4px;
  /* Extra spacious layout for desktop */
  --spacing-alias-large: 64px;
}
",
  "tokens-mod-density-comfortable-platform-mobile-theme-light.css": ":root[data-platform="mobile"] {
  /* Largest touch target */
  --button-primary-padding: 48px;
  /* Softer corners for touch targets */
  --radius-alias-control: 8px;
  /* Softer card rounding on mobile */
  --radius-alias-surface: 12px;
  /* Roomier large spacing on mobile */
  --spacing-alias-large: 48px;
  /* Roomier medium spacing on mobile */
  --spacing-alias-medium: 24px;
  /* Larger spacing for touch */
  --spacing-alias-small: 16px;
}
",
  "tokens-mod-density-compact-platform-desktop-theme-light.css": ":root[data-density="compact"] {
  /* Reduced button padding */
  --button-primary-padding: 4px;
  /* Reduced card padding */
  --card-padding: 8px;
  /* Slightly smaller base text */
  --font-size-base: 12px;
  /* Slightly smaller small text */
  --font-size-sm: 12px;
  /* Tighter large spacing */
  --spacing-alias-large: 16px;
  /* Tighter medium spacing */
  --spacing-alias-medium: 8px;
  /* Tighter small spacing */
  --spacing-alias-small: 4px;
}
",
  "tokens.css": "/* Set: base */
/* Base foundational values */
:root {
  /* Hairline border */
  --border-width-base-hairline: 1px;
  /* Strong border */
  --border-width-base-thick: 3px;
  /* Default border */
  --border-width-base-thin: 2px;
  /* Color in Adobe RGB (1998) color space with alpha */
  --color-base-adobe-rgb-color: color(a98-rgb 0.3 0.6 0.8 / 0.9);
  /* Pure black */
  --color-base-black: color(srgb 0 0 0);
  /* Semi-transparent black */
  --color-base-black-alpha: color(srgb 0 0 0 / 0.7);
  /* Primary brand blue */
  --color-base-blue: color(srgb 0 0.4 1);
  /* Blue with alpha channel */
  --color-base-blue-alpha: color(srgb 0 0.4 1 / 0.8);
  /* Blue in Display P3 color space for wider gamut */
  --color-base-blue-p3: color(display-p3 0 0.4 1);
  /* Blue in sRGB color space with explicit components */
  --color-base-blue-srgb: color(srgb 0 0.4 1);
  /* Dark theme background */
  --color-base-dark-background: color(srgb 0.059 0.078 0.098);
  /* Dark theme border */
  --color-base-dark-border: color(srgb 0.176 0.216 0.282);
  /* Dark theme strong border */
  --color-base-dark-border-strong: color(srgb 0.29 0.333 0.408);
  /* Soft red for dark backgrounds */
  --color-base-dark-danger: color(srgb 0.973 0.443 0.443);
  /* Dark glass effect */
  --color-base-dark-glassmorphism: color(srgb 0.1 0.1 0.15 / 0.8);
  /* Dark theme overlay */
  --color-base-dark-overlay: color(srgb 0 0 0 / 0.7);
  /* Bright blue for dark backgrounds */
  --color-base-dark-primary: color(srgb 0.302 0.604 1);
  /* Bright blue hover for dark backgrounds */
  --color-base-dark-primary-hover: color(srgb 0.416 0.69 1);
  /* Subtle primary for dark theme */
  --color-base-dark-primary-subtle: color(srgb 0.302 0.604 1 / 0.2);
  /* Bright green for dark backgrounds */
  --color-base-dark-success: color(srgb 0.204 0.827 0.6);
  /* Dark theme surface */
  --color-base-dark-surface: color(srgb 0.102 0.122 0.161);
  /* Dark theme text */
  --color-base-dark-text: color(srgb 0.91 0.918 0.929);
  /* Dark theme muted text */
  --color-base-dark-text-muted: color(srgb 0.612 0.639 0.686);
  /* Bright yellow for dark backgrounds */
  --color-base-dark-warning: color(srgb 0.984 0.749 0.141);
  --color-base-gray-100: color(srgb 0.953 0.957 0.965);
  /* Gray 200 using sRGB components */
  --color-base-gray-200: color(srgb 0.898 0.906 0.922);
  /* Lightest gray */
  --color-base-gray-50: color(srgb 0.976 0.98 0.984);
  --color-base-gray-500: color(srgb 0.42 0.447 0.502);
  --color-base-gray-700: color(srgb 0.259 0.294 0.369);
  /* Darkest gray */
  --color-base-gray-900: color(srgb 0.067 0.094 0.153);
  /* Success green */
  --color-base-green: color(srgb 0.063 0.725 0.506);
  /* Green in Rec. 2020 color space for HDR */
  --color-base-green-rec2020: color(rec2020 0.063 0.706 0.506);
  /* HDR green for wide gamut displays */
  --color-base-hdr-green: color(rec2020 0.1 0.9 0.3);
  /* White borders for maximum contrast */
  --color-base-high-contrast-border: color(srgb 1 1 1);
  /* Pure red for high contrast */
  --color-base-high-contrast-danger: color(srgb 1 0 0);
  /* Yellow focus for visibility */
  --color-base-high-contrast-focus: color(srgb 1 1 0);
  /* Cyan for info */
  --color-base-high-contrast-info: color(srgb 0 1 1);
  /* Strong overlay for high contrast */
  --color-base-high-contrast-overlay: color(srgb 0 0 0 / 0.9);
  /* High contrast primary - bright cyan */
  --color-base-high-contrast-primary: color(srgb 0 0.765 1);
  /* High contrast primary hover */
  --color-base-high-contrast-primary-hover: color(srgb 0 0.898 1);
  /* High contrast subtle primary */
  --color-base-high-contrast-primary-subtle: color(srgb 0 0.765 1 / 0.3);
  /* Pure green for high contrast */
  --color-base-high-contrast-success: color(srgb 0 1 0);
  /* High contrast surface */
  --color-base-high-contrast-surface: color(srgb 0.102 0.102 0.102);
  /* High contrast muted text */
  --color-base-high-contrast-text-muted: color(srgb 0.816 0.816 0.816);
  /* Pure yellow for high contrast */
  --color-base-high-contrast-warning: color(srgb 1 1 0);
  /* Primary hover state - slightly darker */
  --color-base-hover-primary: color(srgb 0 0.322 0.8);
  /* Legacy rgba() format */
  --color-base-legacy-srgb-with-alpha: color(srgb 0.392 0.588 0.784 / 0.75);
  /* Orange in sRGB */
  --color-base-orange: color(srgb 0.961 0.62 0.145);
  /* Overlay/backdrop color with alpha */
  --color-base-overlay: color(srgb 0 0 0 / 0.5);
  /* Color in ProPhoto RGB color space for wide gamut */
  --color-base-prophoto-color: color(prophoto-rgb 0.25 0.35 0.45);
  /* Purple accent color */
  --color-base-purple: color(srgb 0.42 0.275 0.757);
  /* Danger red */
  --color-base-red: color(srgb 0.937 0.267 0.267);
  /* Subtle primary with low opacity */
  --color-base-subtle-primary: color(srgb 0 0.4 1 / 0.1);
  /* Vibrant blue in P3 color space */
  --color-base-vibrant-blue-p3: color(display-p3 0.2 0.5 1);
  /* Warning/alert color */
  --color-base-warning: color(srgb 0.961 0.62 0.043);
  /* Pure white */
  --color-base-white: color(srgb 1 1 1);
  /* Semi-transparent white */
  --color-base-white-alpha: color(srgb 1 1 1 / 0.9);
  /* Fast transitions for small changes */
  --duration-fast: 150ms;
  /* Instant - no animation */
  --duration-instant: 0ms;
  /* Normal transition speed */
  --duration-normal: 300ms;
  /* Slow transitions for larger movements */
  --duration-slow: 500ms;
  /* Very slow transitions */
  --duration-slower: 1000ms;
  /* Default ease - slow start and end */
  --easing-ease: 0.25, 0.1, 0.25, 1;
  /* Ease in - slow start */
  --easing-ease-in: 0.42, 0, 1, 1;
  /* Ease in-out - slow start and end */
  --easing-ease-in-out: 0.42, 0, 0.58, 1;
  /* Ease out - slow end */
  --easing-ease-out: 0, 0, 0.58, 1;
  /* Linear easing - constant speed */
  --easing-linear: 0, 0, 1, 1;
  /* Smooth acceleration curve */
  --easing-smooth: 0.4, 0, 0.2, 1;
  /* Spring-like bouncy easing */
  --easing-spring: 0.34, 1.56, 0.64, 1;
  /* Monospace font stack for code */
  --font-family-mono: "JetBrains Mono", Menlo, monospace;
  /* Sans-serif font stack for UI and body text */
  --font-family-sans: Inter, system-ui, sans-serif;
  /* Serif font stack for editorial content */
  --font-family-serif: Georgia, Cambria, "Times New Roman", serif;
  /* Normal letter spacing */
  --font-letter-spacing-normal: 0px;
  /* Tight letter spacing for large text */
  --font-letter-spacing-tight: -0.4px;
  /* Wide letter spacing */
  --font-letter-spacing-wide: 0.4px;
  /* Wider letter spacing for small caps */
  --font-letter-spacing-wider: 0.8px;
  /* 2X large - 24px */
  --font-size-2xl: 24px;
  /* 3X large - 30px */
  --font-size-3xl: 30px;
  /* 4X large - 36px */
  --font-size-4xl: 36px;
  /* 5X large - 48px */
  --font-size-5xl: 48px;
  /* Base - 16px */
  --font-size-base: 16px;
  /* Large - 18px */
  --font-size-lg: 18px;
  /* Small - 14px */
  --font-size-sm: 14px;
  /* Extra large - 20px */
  --font-size-xl: 20px;
  /* Extra small - 12px */
  --font-size-xs: 12px;
  /* Bold weight */
  --font-weight-bold: 700;
  /* Extra bold weight */
  --font-weight-extrabold: 800;
  /* Light weight */
  --font-weight-light: 300;
  /* Medium weight */
  --font-weight-medium: 500;
  /* Normal/regular weight */
  --font-weight-normal: 400;
  /* Semibold weight */
  --font-weight-semibold: 600;
  /* Loose line height for relaxed reading */
  --number-line-height-loose: 1.75;
  /* Normal line height for body text */
  --number-line-height-normal: 1.5;
  /* Tight line height for headings */
  --number-line-height-tight: 1.25;
  /* Full opacity */
  --number-opacity-full: 1;
  /* Light opacity */
  --number-opacity-light: 0.3;
  /* Medium opacity */
  --number-opacity-medium: 0.5;
  /* Strong opacity */
  --number-opacity-strong: 0.8;
  /* Very subtle opacity */
  --number-opacity-subtle: 0.1;
  /* Large scale multiplier */
  --number-scale-large: 1.5;
  /* Normal scale (100%) */
  --number-scale-normal: 1;
  /* Small scale multiplier */
  --number-scale-small: 0.75;
  /* Soft rounding */
  --radius-base-lg: 8px;
  /* Default rounding */
  --radius-base-md: 4px;
  /* Sharp corners */
  --radius-base-none: 0px;
  /* Subtle rounding */
  --radius-base-sm: 2px;
  /* Extra soft rounding */
  --radius-base-xl: 12px;
  /* Accent shadow using brand color */
  --shadow-advanced-accent: var(--shadow-advanced-accent-offsetX)
    var(--shadow-advanced-accent-offsetY) var(--shadow-advanced-accent-blur)
    var(--shadow-advanced-accent-spread) var(--shadow-advanced-accent-color);
  --shadow-advanced-accent-color: var(--color-base-blue);
  --shadow-advanced-accent-offsetX: 0px;
  --shadow-advanced-accent-offsetY: 4px;
  --shadow-advanced-accent-blur: 8px;
  --shadow-advanced-accent-spread: 0px;
  /* Base shadow for layering */
  --shadow-advanced-base: var(--shadow-advanced-base-offsetX)
    var(--shadow-advanced-base-offsetY) var(--shadow-advanced-base-blur)
    var(--shadow-advanced-base-spread) var(--shadow-advanced-base-color);
  --shadow-advanced-base-color: #0000001a;
  --shadow-advanced-base-offsetX: 0px;
  --shadow-advanced-base-offsetY: 2px;
  --shadow-advanced-base-blur: 4px;
  --shadow-advanced-base-spread: 0px;
  /* Focus ring for dark theme */
  --shadow-dark-focus: var(--shadow-dark-focus-0-offsetX)
    var(--shadow-dark-focus-0-offsetY) var(--shadow-dark-focus-0-blur)
    var(--shadow-dark-focus-0-spread) var(--shadow-dark-focus-0-color);
  --shadow-dark-focus-0-color: var(--color-alias-primary);
  --shadow-dark-focus-0-offsetX: 0px;
  --shadow-dark-focus-0-offsetY: 0px;
  --shadow-dark-focus-0-blur: 0px;
  --shadow-dark-focus-0-spread: 3px;
  /* Medium shadow adjusted for dark theme */
  --shadow-dark-md: var(--shadow-dark-md-0-offsetX)
    var(--shadow-dark-md-0-offsetY) var(--shadow-dark-md-0-blur)
    var(--shadow-dark-md-0-spread) var(--shadow-dark-md-0-color);
  --shadow-dark-md-0-color: #0000004d;
  --shadow-dark-md-0-offsetX: 0px;
  --shadow-dark-md-0-offsetY: 4px;
  --shadow-dark-md-0-blur: 8px;
  --shadow-dark-md-0-spread: -1px;
  /* Focus ring shadow using alias color reference */
  --shadow-focus: var(--shadow-focus-0-offsetX) var(--shadow-focus-0-offsetY)
    var(--shadow-focus-0-blur) var(--shadow-focus-0-spread)
    var(--shadow-focus-0-color);
  --shadow-focus-0-color: var(--color-alias-focus);
  --shadow-focus-0-offsetX: 0px;
  --shadow-focus-0-offsetY: 0px;
  --shadow-focus-0-blur: 0px;
  --shadow-focus-0-spread: 3px;
  /* Prominent focus ring for high contrast */
  --shadow-high-contrast-focus: var(--shadow-high-contrast-focus-0-offsetX)
    var(--shadow-high-contrast-focus-0-offsetY)
    var(--shadow-high-contrast-focus-0-blur)
    var(--shadow-high-contrast-focus-0-spread)
    var(--shadow-high-contrast-focus-0-color);
  --shadow-high-contrast-focus-0-color: var(--color-base-high-contrast-focus);
  --shadow-high-contrast-focus-0-offsetX: 0px;
  --shadow-high-contrast-focus-0-offsetY: 0px;
  --shadow-high-contrast-focus-0-blur: 0px;
  --shadow-high-contrast-focus-0-spread: 4px;
  /* Light shadow for high contrast dark theme */
  --shadow-high-contrast-md: var(--shadow-high-contrast-md-0-offsetX)
    var(--shadow-high-contrast-md-0-offsetY)
    var(--shadow-high-contrast-md-0-blur)
    var(--shadow-high-contrast-md-0-spread)
    var(--shadow-high-contrast-md-0-color);
  --shadow-high-contrast-md-0-color: #ffffff26;
  --shadow-high-contrast-md-0-offsetX: 0px;
  --shadow-high-contrast-md-0-offsetY: 4px;
  --shadow-high-contrast-md-0-blur: 8px;
  --shadow-high-contrast-md-0-spread: 0px;
  /* Inner shadow for inset effects */
  --shadow-inner: inset var(--shadow-inner-0-offsetX)
    var(--shadow-inner-0-offsetY) var(--shadow-inner-0-blur)
    var(--shadow-inner-0-spread) var(--shadow-inner-0-color);
  --shadow-inner-0-color: #0000000f;
  --shadow-inner-0-offsetX: 0px;
  --shadow-inner-0-offsetY: 2px;
  --shadow-inner-0-blur: 4px;
  --shadow-inner-0-spread: 0px;
  --shadow-inner-0-inset: true;
  /* Large shadow for prominent elevation */
  --shadow-lg:
    var(--shadow-lg-0-offsetX) var(--shadow-lg-0-offsetY)
      var(--shadow-lg-0-blur) var(--shadow-lg-0-spread) var(--shadow-lg-0-color),
    var(--shadow-lg-1-offsetX) var(--shadow-lg-1-offsetY)
      var(--shadow-lg-1-blur) var(--shadow-lg-1-spread) var(--shadow-lg-1-color);
  --shadow-lg-0-color: #0000001a;
  --shadow-lg-0-offsetX: 0px;
  --shadow-lg-0-offsetY: 10px;
  --shadow-lg-0-blur: 15px;
  --shadow-lg-0-spread: -3px;
  --shadow-lg-1-color: #0000000d;
  --shadow-lg-1-offsetX: 0px;
  --shadow-lg-1-offsetY: 4px;
  --shadow-lg-1-blur: 6px;
  --shadow-lg-1-spread: -2px;
  /* Medium shadow with layered effect */
  --shadow-md:
    var(--shadow-md-0-offsetX) var(--shadow-md-0-offsetY)
      var(--shadow-md-0-blur) var(--shadow-md-0-spread) var(--shadow-md-0-color),
    var(--shadow-md-1-offsetX) var(--shadow-md-1-offsetY)
      var(--shadow-md-1-blur) var(--shadow-md-1-spread) var(--shadow-md-1-color);
  --shadow-md-0-color: #0000001a;
  --shadow-md-0-offsetX: 0px;
  --shadow-md-0-offsetY: 4px;
  --shadow-md-0-blur: 6px;
  --shadow-md-0-spread: -1px;
  --shadow-md-1-color: #0000000f;
  --shadow-md-1-offsetX: 0px;
  --shadow-md-1-offsetY: 2px;
  --shadow-md-1-blur: 4px;
  --shadow-md-1-spread: -1px;
  /* Small shadow for subtle elevation */
  --shadow-sm: var(--shadow-sm-0-offsetX) var(--shadow-sm-0-offsetY)
    var(--shadow-sm-0-blur) var(--shadow-sm-0-spread) var(--shadow-sm-0-color);
  --shadow-sm-0-color: #0000000d;
  --shadow-sm-0-offsetX: 0px;
  --shadow-sm-0-offsetY: 1px;
  --shadow-sm-0-blur: 2px;
  --shadow-sm-0-spread: 0px;
  /* Extra large shadow for maximum elevation */
  --shadow-xl:
    var(--shadow-xl-0-offsetX) var(--shadow-xl-0-offsetY)
      var(--shadow-xl-0-blur) var(--shadow-xl-0-spread) var(--shadow-xl-0-color),
    var(--shadow-xl-1-offsetX) var(--shadow-xl-1-offsetY)
      var(--shadow-xl-1-blur) var(--shadow-xl-1-spread) var(--shadow-xl-1-color);
  --shadow-xl-0-color: #00000026;
  --shadow-xl-0-offsetX: 0px;
  --shadow-xl-0-offsetY: 20px;
  --shadow-xl-0-blur: 25px;
  --shadow-xl-0-spread: -5px;
  --shadow-xl-1-color: #0000001a;
  --shadow-xl-1-offsetX: 0px;
  --shadow-xl-1-offsetY: 10px;
  --shadow-xl-1-blur: 10px;
  --shadow-xl-1-spread: -5px;
  --spacing-base-0: 0px;
  --spacing-base-1: 4px;
  --spacing-base-12: 48px;
  --spacing-base-16: 64px;
  --spacing-base-2: 8px;
  --spacing-base-3: 12px;
  --spacing-base-4: 16px;
  --spacing-base-6: 24px;
  --spacing-base-8: 32px;
}


/* Set: alias */
/* Alias token layer with component tokens */
:root {
  /* Default component outline */
  --border-width-alias-default: var(--border-width-base-thin);
  /* Emphasis or high-contrast outline */
  --border-width-alias-strong: var(--border-width-base-thick);
  /* Danger/error state color */
  --color-alias-danger: var(--color-base-red);
  /* Focus ring color */
  --color-alias-focus: var(--color-base-blue);
  /* Semi-transparent white for glass effects */
  --color-alias-glassmorphism: var(--color-base-white-alpha);
  /* Info color */
  --color-alias-info: var(--color-base-purple);
  /* Stronger overlay using alpha token reference */
  --color-alias-overlay-strong: var(--color-base-black-alpha);
  /* Primary action color referencing base */
  --color-alias-primary: var(--color-base-blue);
  /* Subtle primary with low opacity */
  --color-alias-primary-subtle: var(--color-base-subtle-primary);
  /* Success state color */
  --color-alias-success: var(--color-base-green);
  /* Warning color */
  --color-alias-warning: var(--color-base-warning);
  /* Primary button background */
  --color-button-primary-background: var(--color-alias-primary);
  /* Primary button hover state */
  --color-button-primary-background-hover: var(--color-alias-primary-hover);
  /* Primary button text color */
  --color-button-primary-text: var(--color-base-white);
  /* Card background color */
  --color-card-background: var(--color-alias-surface);
  /* Card border color */
  --color-card-border: var(--color-alias-border);
  /* Card elevation shadow (medium) */
  --shadow-card-shadow: var(--shadow-md);
  --spacing-alias-medium: var(--spacing-base-4);
  --spacing-alias-small: var(--spacing-base-2);
  /* Button padding */
  --spacing-button-primary-padding: var(--spacing-alias-medium);
  /* Card internal padding */
  --spacing-card-padding: var(--spacing-alias-large);
}


/* Modifier: platform=desktop (default) */
/* Platform-specific adjustments */
:root {
  /* Sharper control corners on desktop */
  --radius-alias-control: var(--radius-base-sm);
  /* Sharper surface corners on desktop */
  --radius-alias-surface: var(--radius-base-md);
  /* Extra spacious layout for desktop */
  --spacing-alias-large: var(--spacing-base-16);
}


/* Modifier: theme=light (default) */
/* Theme variations */
:root {
  /* Light theme background */
  --color-alias-background: var(--color-base-white);
  /* Subtle border for light theme */
  --color-alias-border: var(--color-base-gray-100);
  /* Stronger border for emphasis */
  --color-alias-border-strong: var(--color-base-gray-500);
  /* Semi-transparent dark overlay */
  --color-alias-overlay: var(--color-base-overlay);
  /* Darker primary on hover */
  --color-alias-primary-hover: var(--color-base-hover-primary);
  /* Light theme surface */
  --color-alias-surface: var(--color-base-gray-50);
  /* Light theme text */
  --color-alias-text: var(--color-base-gray-900);
  /* Light theme muted text */
  --color-alias-text-muted: var(--color-base-gray-500);
}


/* Modifier: platform=mobile */
:root[data-platform="mobile"] {
  /* Largest touch target */
  --button-primary-padding: var(--spacing-alias-large);
  /* Softer corners for touch targets */
  --radius-alias-control: var(--radius-base-lg);
  /* Softer card rounding on mobile */
  --radius-alias-surface: var(--radius-base-xl);
  /* Roomier large spacing on mobile */
  --spacing-alias-large: var(--spacing-base-12);
  /* Roomier medium spacing on mobile */
  --spacing-alias-medium: var(--spacing-base-6);
  /* Larger spacing for touch */
  --spacing-alias-small: var(--spacing-base-4);
}


/* Modifier: density=compact */
:root[data-density="compact"] {
  /* Reduced button padding */
  --button-primary-padding: var(--spacing-alias-small);
  /* Reduced card padding */
  --card-padding: var(--spacing-alias-medium);
  /* Slightly smaller base text */
  --font-size-base: var(--font-size-sm);
  /* Slightly smaller small text */
  --font-size-sm: var(--font-size-xs);
  /* Tighter large spacing */
  --spacing-alias-large: var(--spacing-base-4);
  /* Tighter medium spacing */
  --spacing-alias-medium: var(--spacing-base-2);
  /* Tighter small spacing */
  --spacing-alias-small: var(--spacing-base-1);
}


/* Modifier: theme=dark */
:root[data-theme="dark"] {
  /* Dark theme background - deeper than base gray.900 */
  --color-alias-background: var(--color-base-dark-background);
  /* Subdued border for dark theme */
  --color-alias-border: var(--color-base-dark-border);
  /* Stronger border still subtle */
  --color-alias-border-strong: var(--color-base-dark-border-strong);
  /* Softer red for dark backgrounds */
  --color-alias-danger: var(--color-base-dark-danger);
  /* Dark glass effect */
  --color-alias-glassmorphism: var(--color-base-dark-glassmorphism);
  /* Stronger overlay for dark theme */
  --color-alias-overlay: var(--color-base-dark-overlay);
  /* Brighter blue for dark backgrounds using sRGB */
  --color-alias-primary: var(--color-base-dark-primary);
  /* Even brighter on hover */
  --color-alias-primary-hover: var(--color-base-dark-primary-hover);
  /* Subtle primary for dark theme */
  --color-alias-primary-subtle: var(--color-base-dark-primary-subtle);
  /* Brighter green for dark backgrounds */
  --color-alias-success: var(--color-base-dark-success);
  /* Dark theme surface - elevated from background */
  --color-alias-surface: var(--color-base-dark-surface);
  /* Dark theme text - slightly off-white for reduced eye strain */
  --color-alias-text: var(--color-base-dark-text);
  /* Dark theme muted text */
  --color-alias-text-muted: var(--color-base-dark-text-muted);
  /* Bright yellow for dark backgrounds */
  --color-alias-warning: var(--color-base-dark-warning);
  /* Focus ring with dark theme primary color */
  --shadow-focus: var(--shadow-dark-focus);
  /* Medium shadow adjusted for dark theme */
  --shadow-md: var(--shadow-dark-md);
}


/* Modifier: theme=high-contrast */
:root[data-theme="high-contrast"] {
  /* Thicker outlines for high contrast */
  --border-width-alias-default: var(--border-width-base-thick);
  /* Strong outlines for emphasis */
  --border-width-alias-strong: var(--border-width-base-thick);
  /* High contrast background - pure black */
  --color-alias-background: var(--color-base-black);
  /* White borders for maximum contrast */
  --color-alias-border: var(--color-base-high-contrast-border);
  /* Same as border in high contrast */
  --color-alias-border-strong: var(--color-base-high-contrast-border);
  /* Pure red for high contrast */
  --color-alias-danger: var(--color-base-high-contrast-danger);
  /* Yellow focus rings for visibility */
  --color-alias-focus: var(--color-base-high-contrast-focus);
  /* Cyan for info */
  --color-alias-info: var(--color-base-high-contrast-info);
  /* Strong overlay */
  --color-alias-overlay: var(--color-base-high-contrast-overlay);
  /* High contrast primary - bright cyan for maximum visibility */
  --color-alias-primary: var(--color-base-high-contrast-primary);
  /* Even brighter on hover */
  --color-alias-primary-hover: var(--color-base-high-contrast-primary-hover);
  /* Subtle primary still visible in high contrast */
  --color-alias-primary-subtle: var(--color-base-high-contrast-primary-subtle);
  /* Pure green for high contrast */
  --color-alias-success: var(--color-base-high-contrast-success);
  /* High contrast surface - slightly elevated */
  --color-alias-surface: var(--color-base-high-contrast-surface);
  /* High contrast text - pure white */
  --color-alias-text: var(--color-base-white);
  /* High contrast muted text - still very legible */
  --color-alias-text-muted: var(--color-base-high-contrast-text-muted);
  /* Pure yellow for high contrast */
  --color-alias-warning: var(--color-base-high-contrast-warning);
  /* Extra-bold for high contrast */
  --font-weight-bold: var(--font-weight-extrabold);
  /* Semi-bold for emphasis */
  --font-weight-medium: var(--font-weight-semibold);
  /* Medium weight for better readability */
  --font-weight-normal: var(--font-weight-medium);
  /* Sharp corners for high contrast */
  --radius-alias-control: var(--radius-base-none);
  /* Sharp surfaces for high contrast */
  --radius-alias-surface: var(--radius-base-none);
  /* Prominent focus ring for high contrast */
  --shadow-focus: var(--shadow-high-contrast-focus);
  /* Light shadow for high contrast dark theme */
  --shadow-md: var(--shadow-high-contrast-md);
  /* Much larger spacing */
  --spacing-semantic-large: var(--spacing-base-12);
  /* Larger spacing for better separation */
  --spacing-semantic-medium: var(--spacing-base-6);
  /* Slightly larger spacing for high contrast */
  --spacing-semantic-small: var(--spacing-base-3);
}


/* Modifier: theme=forest */
:root[data-theme="forest"] {
  /* Soft forest fog background */
  --color-alias-background: var(--color-base-gray-50);
  /* Soft bark border */
  --color-alias-border: var(--color-base-gray-200);
  /* Strong bark border */
  --color-alias-border-strong: var(--color-base-gray-500);
  /* Forest overlay */
  --color-alias-overlay: var(--color-base-overlay);
  /* Forest green accent */
  --color-alias-primary: var(--color-base-green);
  /* Brighter green hover */
  --color-alias-primary-hover: var(--color-base-hdr-green);
  /* Soft green wash */
  --color-alias-primary-subtle: var(--color-base-subtle-primary);
  /* Forest success green */
  --color-alias-success: var(--color-base-green);
  /* Raised surface on fog */
  --color-alias-surface: var(--color-base-white);
  /* Deep forest text */
  --color-alias-text: var(--color-base-gray-900);
  /* Muted forest text */
  --color-alias-text-muted: var(--color-base-gray-700);
}
