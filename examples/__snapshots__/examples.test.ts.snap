{
  "css/tokens.css": "/* Set: base */
/* Foundational base values (no references) */
:root {
  --color-palette-blue-500: #1a66f2;
  --color-palette-blue-600: #0d52d6;
  --color-palette-green-500: #1fb35c;
  --color-palette-green-600: #14944a;
  --color-palette-neutral-0: #ffffff;
  --color-palette-neutral-100: #f7f7fa;
  --color-palette-neutral-1000: #0a0d12;
  --color-palette-neutral-200: #edf0f2;
  --color-palette-neutral-800: #292e38;
  --color-palette-neutral-900: #1a1c24;
  --color-palette-red-500: #e63333;
  --color-palette-red-600: #c72424;
  --duration-fast: 120ms;
  --duration-normal: 200ms;
  --duration-slow: 320ms;
  --elevation-shadow-100: var(--elevation-shadow-100-offsetX)
    var(--elevation-shadow-100-offsetY) var(--elevation-shadow-100-blur)
    var(--elevation-shadow-100-spread) var(--elevation-shadow-100-color);
  --elevation-shadow-100-color: #0000001f;
  --elevation-shadow-100-offsetX: 0px;
  --elevation-shadow-100-offsetY: 1px;
  --elevation-shadow-100-blur: 2px;
  --elevation-shadow-100-spread: 0px;
  --elevation-shadow-200: var(--elevation-shadow-200-offsetX)
    var(--elevation-shadow-200-offsetY) var(--elevation-shadow-200-blur)
    var(--elevation-shadow-200-spread) var(--elevation-shadow-200-color);
  --elevation-shadow-200-color: #00000029;
  --elevation-shadow-200-offsetX: 0px;
  --elevation-shadow-200-offsetY: 4px;
  --elevation-shadow-200-blur: 10px;
  --elevation-shadow-200-spread: 0px;
  --opacity-0: 0;
  --opacity-10: 0.1;
  --opacity-100: 1;
  --opacity-30: 0.3;
  --opacity-50: 0.5;
  --opacity-80: 0.8;
  --radius-100: 4px;
  --radius-200: 8px;
  --radius-300: 12px;
  --space-scale-0: 0px;
  --space-scale-100: 8px;
  --space-scale-150: 12px;
  --space-scale-200: 16px;
  --space-scale-300: 24px;
  --space-scale-400: 32px;
  --space-scale-50: 4px;
}


/* Set: semantic */
/* Semantic tokens referencing base values */
:root {
  --color-background-selected: var(--color-palette-blue-500);
  --color-background-surface-raised: var(--color-palette-neutral-0);
  --color-border-danger: var(--color-palette-red-500);
  --color-border-focused: var(--color-palette-blue-600);
  --color-icon-danger: var(--color-text-danger);
  --color-icon-default: var(--color-text-subtle);
  --color-icon-inverse: var(--color-text-inverse);
  --color-icon-success: var(--color-text-success);
  --color-text-danger: var(--color-palette-red-600);
  --color-text-success: var(--color-palette-green-600);
  --elevation-overlay: var(--elevation-shadow-200);
  --elevation-surface: var(--elevation-shadow-100);
  --opacity-disabled: var(--opacity-50);
  --opacity-loading: var(--opacity-30);
  --radius-lg: var(--radius-300);
  --radius-md: var(--radius-200);
  --radius-sm: var(--radius-100);
  --space-0: var(--space-scale-0);
  --space-400: var(--space-scale-400);
}


/* Set: components */
/* Component tokens referencing semantic tokens */
:root {
  --color-badge-danger-background: var(--color-palette-red-500);
  --color-badge-danger-text: var(--color-text-inverse);
  --color-badge-success-background: var(--color-palette-green-500);
  --color-badge-success-text: var(--color-text-inverse);
  --color-button-primary-background: var(--color-palette-blue-600);
  --color-button-primary-background-hover: var(--color-palette-blue-500);
  --color-button-primary-border: var(--color-border-focused);
  --color-button-primary-text: var(--color-text-inverse);
  --color-surface-card-background: var(--color-background-surface-raised);
  --color-surface-card-border: var(--color-border-default);
  --duration-button-primary-transition-duration: var(--motion-duration-normal);
  --shadow-surface-card-shadow: var(--elevation-surface);
  --spacing-badge-danger-padding-block: var(--space-50);
  --spacing-badge-danger-padding-inline: var(--space-100);
  --spacing-badge-danger-radius: var(--radius-sm);
  --spacing-badge-success-padding-block: var(--space-50);
  --spacing-badge-success-padding-inline: var(--space-100);
  --spacing-badge-success-radius: var(--radius-sm);
  --spacing-button-primary-padding-block: var(--space-100);
  --spacing-button-primary-padding-inline: var(--space-150);
  --spacing-button-primary-radius: var(--radius-md);
  --spacing-surface-card-padding: var(--space-200);
  --spacing-surface-card-radius: var(--radius-lg);
}


/* Modifier: density=cozy (default) */
/* Density modes (compact/cozy/comfortable) */
:root {
  --space-100: var(--space-scale-100);
  --space-150: var(--space-scale-150);
  --space-200: var(--space-scale-200);
  --space-300: var(--space-scale-300);
  --space-50: var(--space-scale-50);
}


/* Modifier: theme=light (default) */
/* Theme modes (light/dark/high-contrast) */
:root {
  --color-background-canvas: var(--color-palette-neutral-0);
  --color-background-surface: var(--color-palette-neutral-100);
  --color-border-default: var(--color-palette-neutral-200);
  --color-text-default: var(--color-palette-neutral-1000);
  --color-text-inverse: var(--color-palette-neutral-0);
  --color-text-subtle: var(--color-palette-neutral-800);
}


/* Modifier: motion=standard (default) */
/* Motion preference (standard/reduced-motion) */
:root {
  --motion-duration-fast: var(--duration-fast);
  --motion-duration-normal: var(--duration-normal);
  --motion-duration-slow: var(--duration-slow);
}


/* Modifier: density=compact */
[data-density="compact"] {
  --button-primary-padding-block: var(--space-50);
  --button-primary-padding-inline: var(--space-150);
  --space-100: 6px;
  --space-150: 10px;
  --space-200: 14px;
  --space-50: 2px;
}


/* Modifier: density=comfortable */
[data-density="comfortable"] {
  --space-100: 10px;
  --space-150: 14px;
  --space-200: 18px;
  --space-300: 28px;
  --space-400: 36px;
  --space-50: 6px;
  --surface-card-padding: var(--space-300);
}


/* Modifier: theme=dark */
[data-theme="dark"] {
  --color-background-canvas: var(--color-palette-neutral-1000);
  --color-background-surface: var(--color-palette-neutral-900);
  --color-background-surface-raised: var(--color-palette-neutral-800);
  --color-border-default: var(--color-palette-neutral-800);
  --color-border-focused: var(--color-palette-blue-500);
  --color-text-default: var(--color-palette-neutral-0);
  --color-text-inverse: var(--color-palette-neutral-1000);
  --color-text-subtle: var(--color-palette-neutral-200);
}


/* Modifier: theme=high-contrast */
[data-theme="high-contrast"] {
  --color-background-canvas: var(--color-palette-neutral-1000);
  --color-background-surface: var(--color-palette-neutral-1000);
  --color-border-default: var(--color-palette-neutral-0);
  --color-border-focused: var(--color-palette-neutral-0);
  --color-text-default: var(--color-palette-neutral-0);
  --color-text-subtle: var(--color-palette-neutral-0);
}


/* Modifier: motion=reduced-motion */
[data-motion="reduced-motion"] {
  --motion-duration-fast: 0ms;
  --motion-duration-normal: 0ms;
  --motion-duration-slow: 0ms;
}
